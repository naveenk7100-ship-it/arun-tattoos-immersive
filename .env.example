# ARUN TATTOOS - PRODUCTION & LOCAL CONFIGURATION
# Copy to .env and replace placeholders with your private production credentials.

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets (Generate a 32+ character high-entropy key)
JWT_SECRET=arun_tattoos_master_jwt_secret_production_key_32_chars_min

# Initial Seed Admin Account (Initialized automatically on first boot)
ADMIN_EMAIL=admin@aruntattoostudio.com
ADMIN_PASSWORD=ArunTattoos@Vijayawada2025

# Public Frontend API URL (Vite proxies /api to PORT 3001 in dev)
VITE_API_URL=/api

# Optional: External Notification Providers (Uncomment when credentials available)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_key
# NOTIFICATION_FROM_EMAIL=concierge@aruntattoostudio.com
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Optional: Supabase Connection (If deploying on Supabase PostgreSQL)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
